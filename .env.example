# Copy this file to .env and fill in your real credentials
# NEVER commit .env to GitHub

WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here
WHOOP_REDIRECT_URI=http://localhost:8000/callback

# See docs/setup-strava.md for how to register a Strava API app
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:8001/callback

# Daily email (src/notifications/daily_email.py)
# See docs/setup-daily-email.md for how to create a Gmail App Password
GMAIL_USER=martinj001@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here
EMAIL_TO=martinj001@gmail.com
